{
  "name": "@strutvane/log-viewer",
  "version": "0.2.0-next.0",
  "description": "A log viewer for Strutvane apps: browse, search, filter, tail and export the framework's log files (line and json, every process merged by time) from a locked-down page or a React screen.",
  "keywords": [
    "strutvane",
    "log-viewer",
    "logs",
    "logging",
    "viewer",
    "react",
    "typescript",
    "nodejs"
  ],
  "homepage": "https://github.com/vishwajit-vm/strutvane-log-viewer#readme",
  "bugs": {
    "url": "https://github.com/vishwajit-vm/strutvane-log-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishwajit-vm/strutvane-log-viewer.git"
  },
  "license": "MIT",
  "author": "The Strutvane Authors",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "default": "./dist/react/index.mjs"
    },
    "./provider": {
      "types": "./dist/provider.d.mts",
      "default": "./dist/provider.mjs"
    },
    "./installer": {
      "types": "./dist/installer.d.mts",
      "default": "./dist/installer.mjs"
    },
    "./http": {
      "types": "./dist/http.d.mts",
      "default": "./dist/http.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "default": "./dist/node.mjs"
    },
    "./hono": {
      "types": "./dist/hono.d.mts",
      "default": "./dist/hono.mjs"
    },
    "./express": {
      "types": "./dist/express.d.mts",
      "default": "./dist/express.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "ci": "biome check . && tsc --noEmit && vitest run --coverage && tsdown",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "@strutvane/framework": "^0.2.0-next.0",
    "express": "^5.0.0",
    "hono": "^4.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@changesets/cli": "3.0.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "express": "5.3.0",
    "fast-check": "4.10.2",
    "hono": "4.13.18",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "strutvane": {
    "id": "log-viewer",
    "name": "Log viewer",
    "description": "Browse, search, tail and export the app's logs at /_strutvane/logs.",
    "category": "operations",
    "tags": [
      "logs",
      "observability",
      "debugging"
    ],
    "compat": "^0.2.0-next.0",
    "installer": "./dist/installer.mjs",
    "docs": "https://github.com/vishwajit-vm/strutvane-log-viewer#readme"
  }
}
